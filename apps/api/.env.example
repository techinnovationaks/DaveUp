# DaveUp API settings.
# Copy to apps/api/.env and fill in what you need. Never commit .env.
# Everything here is optional in development: a commented-out line uses the
# default shown. In production the values marked "required in production"
# must be set, or the API refuses to start.
# Variables already set in your shell or on the host override this file.

# ---- Server ----
# PORT=4000
# NODE_ENV=development          # "production" on a live server

# ---- Database (required in production) ----
# Owner connection: migrations, sign-in, church lookup. Bypasses row-level security.
# OWNER_DATABASE_URL=postgres://daveup_owner:daveup_owner_dev@localhost:5433/daveup
# App connection: all church data. Subject to row-level security.
# APP_DATABASE_URL=postgres://daveup_app:daveup_app_dev@localhost:5433/daveup

# ---- Security (required in production) ----
# Long random value used to hash sign-in codes and session tokens.
# Generate one with: openssl rand -hex 32
# AUTH_SECRET=change-me
# SESSION_DAYS=30

# ---- Email (Brevo) ----
# Email is the main way to sign in (a 6-digit code), and the channel for notifications.
# Without a key, development prints emails (including codes) in the API terminal.
# Production requires BREVO_API_KEY, EMAIL_FROM and APP_URL.
# BREVO_API_KEY=
# The sender must be verified in Brevo (Senders, Domains & Dedicated IPs).
# EMAIL_FROM=no-reply@yourchurchdomain.org
# EMAIL_FROM_NAME=DaveUp
# Public web address, used for links in emails.
# APP_URL=http://localhost:3000
# Time zone for dates and times written in emails.
# APP_TIMEZONE=Africa/Lagos
# brevo, smtp or console (development only). Defaults to brevo when a key is set, else smtp when SMTP_HOST is set.
# EMAIL_PROVIDER=
# Set to off if a separate worker process sends the email queue.
# NOTIFICATION_WORKER=on

# ---- Email through any SMTP server (Nodemailer) ----
# EMAIL_PROVIDER=smtp uses these. With SMTP_HOST empty in development, emails go to a
# free Ethereal test mailbox and the API terminal prints a link to view each one.
# Example, Gmail with an app password: SMTP_HOST=smtp.gmail.com SMTP_PORT=465
# SMTP_HOST=
# SMTP_PORT=587                  # 465 = TLS from the start, 587 = STARTTLS
# SMTP_SECURE=                   # defaults to true for port 465
# SMTP_USER=
# SMTP_PASS=

# ---- Phone sign-in (SMS codes, optional) ----
# none    = phone number only, no code (default while there is no SMS account).
#           Anyone who knows a number can sign in as that person.
# termii  = real SMS/WhatsApp codes (used automatically when TERMII_API_KEY is set)
# console = code printed in the API terminal (development only)
# OTP_PROVIDER=none
# TERMII_API_KEY=
# TERMII_SENDER_ID=DaveUp
# TERMII_BASE_URL=https://api.ng.termii.com
# TERMII_CHANNEL=dnd             # dnd (SMS), whatsapp or generic

# Production refuses sign-in without codes unless this is set on purpose.
# ALLOW_PHONE_ONLY_SIGNIN=false

# ---- DaveUp staff (super administrators) ----
# Comma-separated emails. A person whose VERIFIED email is listed can open the
# staff console (/staff) to verify and suspend churches. They can then give
# other people staff access from the console.
# SUPER_ADMIN_EMAILS=you@example.org

# Sign in with Google: an OAuth client ID ("Web application") from Google Cloud
# Console. Redirect URI: APP_URL + /api/auth/google/callback. Off until both are set.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ---- Audio and video calls (LiveKit) ----
# Calls are off (buttons hidden) until all three are set.
# LiveKit Cloud: create a project at https://cloud.livekit.io and copy its URL and keys.
# Local: `livekit-server --dev --bind 127.0.0.1 --node-ip 127.0.0.1`, then
#   LIVEKIT_URL=ws://localhost:7880  LIVEKIT_API_KEY=devkey  LIVEKIT_API_SECRET=secret
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# ---- Shared files (S3-compatible storage) ----
# Development keeps files in apps/api/.uploads unless a bucket is set.
# Production needs a bucket (Cloudflare R2, AWS S3, Backblaze B2), or file sharing is off.
# The bucket needs a CORS rule allowing PUT from the web app's origin (see README, "Files").
# Cloudflare R2: S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com  S3_REGION=auto
# S3_ENDPOINT=
# S3_REGION=auto
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# STORAGE_PROVIDER=              # s3 or local (development only)
# LOCAL_STORAGE_DIR=             # default apps/api/.uploads

# Church plans paid through Paystack (see README, "Plans and billing").
# Secret key from Paystack → Settings → API Keys & Webhooks. sk_test_... for testing.
# PAYSTACK_SECRET_KEY=
